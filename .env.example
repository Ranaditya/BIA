# GitHub Credentials & Configuration
# =====================================
# 
# IMPORTANT: DO NOT commit this file to Git!
# This file contains sensitive credentials.
# It is listed in .gitignore and should never be pushed to GitHub.
#
# HOW TO SET UP:
# 1. Copy this file: cp .env.example .env
# 2. Fill in your actual values (see instructions below)
# 3. Keep .env in .gitignore (never commit it)
#

# ────────────────────────────────────────────────────────────────────────────
# GITHUB CREDENTIALS (Required for pushing code to GitHub)
# ────────────────────────────────────────────────────────────────────────────

# Your GitHub username
# Get it from: https://github.com/settings/profile
GITHUB_USERNAME=your_github_username

# GitHub Personal Access Token (for authentication)
# Create one at: https://github.com/settings/tokens
# Scopes needed: repo (full control of private repositories)
GITHUB_TOKEN=your_github_personal_access_token

# GitHub Repository name
GITHUB_REPO=BIA

# ────────────────────────────────────────────────────────────────────────────
# PROJECT CONFIGURATION
# ────────────────────────────────────────────────────────────────────────────

PROJECT_NAME=BIA
PROJECT_DESCRIPTION=Business Intelligence & Analytics - Machine Learning Projects
PYTHON_ENV=production

# ────────────────────────────────────────────────────────────────────────────
# FUTURE: API Keys (Optional - for future ML projects)
# ────────────────────────────────────────────────────────────────────────────

# OPENAI_API_KEY=sk-...
# KAGGLE_API_KEY=...
# HUGGINGFACE_TOKEN=hf_...
